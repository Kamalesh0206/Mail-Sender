# ==============================================================================
# AI Birthday & Wishes Email Agent - Environment Variables Configuration
# ==============================================================================

# Application Environment
DEBUG=True
FRONTEND_URL=http://localhost:5173

# Secret Key (used for cryptographic operations and app security)
SECRET_KEY=replace_with_a_secure_random_string_min_32_characters

# Fernet 32-byte Base64 key for encrypting OAuth tokens (Optional - auto-derived if omitted)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=5vVq7X7n_F7sZl8H_vJ4Y6vV-qX7n_F7sZl8HvJ4Y6s=

# Database Connection URL
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/wishes_db
# For SQLite (default for instant zero-configuration local dev):
DATABASE_URL=sqlite:///./wishes.db

# Google Gemini API Key (Direct API - no LangChain / CrewAI)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DEFAULT_AI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Credentials (for Gmail API access)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Scheduler Configuration (24-hour format)
SCHEDULER_ENABLED=True
DEFAULT_DAILY_HOUR=8
DEFAULT_DAILY_MINUTE=0

# Default Sender Identity
DEFAULT_SENDER_NAME=Kamalesh
DEFAULT_SIGNATURE=Best wishes,
Kamalesh
DEFAULT_APPROVAL_MODE=APPROVAL
